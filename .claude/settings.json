{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make e2e)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make audit)",
      "Bash(make check)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/pip-audit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker logs:*)",
      "Bash(curl -s http://localhost:8080/api/health)",
      "Bash(curl -s http://localhost:8080/api/models)",
      "Bash(curl -s http://localhost:8080/api/tts/languages)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-format.sh"
          }
        ]
      }
    ]
  }
}
