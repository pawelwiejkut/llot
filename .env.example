# Copy to .env and adjust. Used by `python run.py` and by docker compose.

# Ollama server and default model.
# host.docker.internal = the Docker host (Ollama there must listen on 0.0.0.0, see docs).
# Ollama on another machine: http://<ip>:11434. Running `python run.py` outside Docker: http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OL_MODEL=gemma4:26b

# Bind address for `python run.py` (Docker always listens on 8080 inside the container;
# with docker compose APP_PORT is the published host port)
APP_HOST=0.0.0.0
APP_PORT=8080
FLASK_DEBUG=0
DEBUG_LOGGING=false

# Optional: Wyoming TTS server (wyoming-piper, wyoming_openai, ...). Leave empty to disable TTS.
# Voices are discovered automatically from the server.
#WYOMING_TTS_HOST=192.168.1.10
#WYOMING_TTS_PORT=10200
# Optional: force a specific voice per language
#WYOMING_TTS_VOICES=pl=pl_PL-gosia-medium,en=en_US-lessac-medium

# Optional: limit translation languages (comma-separated codes). Default: all.
#TRANSLATION_LANGUAGES=en,de,pl,cs
